---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer/Footer.astro";
import Header from "../components/Header/Header.astro";
import CommandPalette from "../components/CommandPalette/CommandPalette.astro";
import "../styles/tailwind.css";
import "../styles/tokens.css";
import "../styles/layer.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
const pageTitle = Astro.url.pathname === "/" ? title : `${title} · Joeri Kaiser`;
---

<!doctype html>
<html lang="en" transition:animate="none" data-no-hero-transition>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#faf6f1" />
    <title>{pageTitle}</title>
    <!-- Fonts are self-hosted in tokens.css. -->
  </head>
  <body>
    <ClientRouter />

    <div transition:persist="header">
      <Header />
    </div>

    <slot />

    <div transition:persist="footer">
      <Footer />
    </div>

    <CommandPalette />
  </body>
</html>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(hero-section),
    ::view-transition-new(hero-section) {
      animation: none !important;
    }
  }
</style>
