---
import { type CollectionEntry, render } from "astro:content";
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { formatDate } from "../../utils/time";
import SkillChip from "../About/SkillChip.astro";

interface Props {
  project: CollectionEntry<"project">;
  index: number;
}

type ImageType = {
  src: string;
  alt?: string;
};

const { project, index } = Astro.props;
const { data } = project;
const { name, img, timeline } = data;
const { Content } = await render(project);

// Raster images live in src/assets so Astro can optimize them (AVIF/WebP +
// responsive srcset). Frontmatter references them as "/images/<project>/<file>".
const projectImages = import.meta.glob("../../assets/images/projects/**/*.{png,jpg,jpeg,webp}", {
  eager: true,
  import: "default",
}) as Record<string, ImageMetadata>;

const imageMap = new Map<string, ImageMetadata>();
for (const [key, meta] of Object.entries(projectImages)) {
  imageMap.set(key.split("projects/")[1], meta);
}

type ResolvedImage = { alt: string; asset?: ImageMetadata; url?: string };

const resolvedImages: ResolvedImage[] = (img ?? []).map((image: ImageType, i: number) => {
  const src = image.src.startsWith("/") ? image.src : `/${image.src}`;
  const asset = imageMap.get(src.replace(/^\/images\//, ""));
  return {
    alt: image.alt || `${name} screenshot ${i + 1}`,
    asset,
    url: asset ? undefined : src,
  };
});

const techStackFromData = data.techStack || [];

const techColorMap: Record<string, string> = {
  React: "#61DAFB",
  TypeScript: "#3178C6",
  Astro: "#c4704b",
  GSAP: "#7d8471",
  "Three.js": "#4a3c2a",
  Vercel: "#4a3c2a",
  Docker: "#2496ED",
  "PHP Symfony": "#4a3c2a",
  Symfony: "#4a3c2a",
  "Node.js": "#7d8471",
  TailwindCSS: "#06B6D4",
  MySQL: "#4479A1",
  PostgreSQL: "#4169E1",
  Git: "#c4704b",
  Linux: "#FCC624",
  GraphQL: "#c4704b",
  Tauri: "#4a3c2a",
};

const techStack = techStackFromData.map((skill) => ({
  name: skill.name,
  color: skill.color || techColorMap[skill.name] || "#c4704b",
}));

// Alternate rotation for organic feel
const rotations = [-1.5, 1, -0.5, 1.5, -1, 0.5];
const rotation = rotations[index % rotations.length];
const projectNumber = String(index + 1).padStart(2, "0");
---

<article
  id={`project-${project.id}`}
  class="project-card"
  data-project-item
  style={`--card-rotation: ${rotation}deg;`}
>
  <div class="card-inner" tabindex="0">
    <!-- Card decorations -->
    <div class="card-tape card-tape-top" aria-hidden="true"></div>

    <!-- Project number -->
    <div class="project-number" aria-hidden="true">
      {projectNumber}.
    </div>

    <!-- Header -->
    <header class="project-header" data-project-header>
      <time class="project-date" datetime={timeline.start.toISOString()}>
        {
          `${formatDate(new Date(timeline.start))} — ${!timeline.end ? "Present" : formatDate(new Date(timeline.end))}`
        }
      </time>

      <h2 class="project-title" data-project-title>
        {name}
      </h2>
    </header>

    <!-- Content -->
    <div class="project-content">
      <div class="project-description prose-article" data-project-description>
        <Content />
      </div>

      <div class="project-grid">
        {
          resolvedImages.length > 0 && (
            <div class="project-images" data-project-images>
              {resolvedImages.map((image, imgIndex) => (
                <div class="image-frame" data-project-image-wrapper data-image-index={imgIndex}>
                  {image.asset ? (
                    <Picture
                      src={image.asset}
                      widths={[320, 640, 960]}
                      sizes="(min-width: 768px) 480px, calc(100vw - 3rem)"
                      formats={["avif"]}
                      fallbackFormat="webp"
                      alt={image.alt}
                      loading="lazy"
                      decoding="async"
                      class="project-image"
                      data-project-image
                    />
                  ) : (
                    <img
                      src={image.url}
                      alt={image.alt}
                      loading="lazy"
                      decoding="async"
                      class="project-image"
                      data-project-image
                    />
                  )}
                  <div class="image-overlay" data-image-overlay />
                </div>
              ))}
            </div>
          )
        }

        {
          techStack.length > 0 && (
            <div
              class={`project-tech ${resolvedImages.length === 0 ? "full-width" : ""}`}
              data-tech-section
            >
              <h3 class="tech-label">Built with</h3>
              <SkillChip skills={techStack} compact={true} />
            </div>
          )
        }
      </div>
    </div>

    <!-- Corner fold decoration -->
    <div class="corner-fold" aria-hidden="true"></div>
  </div>
</article>

<script>
  import { observeReveal } from "../../utils/reveal";

  document.addEventListener("astro:page-load", () => {
    observeReveal("[data-project-item]");
  });
</script>

<style>
  .project-card {
    margin-bottom: var(--space-2xl);
    scroll-margin-top: 2rem;
  }

  .project-card:last-child {
    margin-bottom: 0;
  }

  .card-inner {
    position: relative;
    background: linear-gradient(175deg, var(--wc-cream) 0%, var(--wc-parchment) 100%);
    border: 1px solid var(--wc-sand);
    border-radius: var(--radius-lg);
    padding: var(--space-l);
    box-shadow:
      var(--shadow-md),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
    transform: rotate(var(--card-rotation, 0deg));
    transition: transform var(--duration-normal) var(--ease-bounce);
  }

  .card-inner:hover,
  .card-inner:focus-visible {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: var(--shadow-lg);
    outline: none;
  }

  @media (min-width: 768px) {
    .card-inner:hover,
    .card-inner:focus-visible {
      transform: rotate(0deg) translateY(-6px);
    }
  }

  /* Decorative tape */
  .card-tape {
    position: absolute;
    width: 60px;
    height: 22px;
    border-radius: 2px;
    z-index: 10;
  }

  .card-tape-top {
    top: -10px;
    left: 15%;
    background: var(--wc-accent-muted);
    opacity: 0.8;
    transform: rotate(-6deg);
  }

  /* Corner fold */
  .corner-fold {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, transparent 50%, var(--wc-sand) 50%);
    border-radius: 0 0 var(--radius-lg) 0;
  }

  /* Project number */
  .project-number {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: var(--wc-accent);
    opacity: 0.3;
    line-height: 1;
    pointer-events: none;
  }

  /* Header */
  .project-header {
    margin-bottom: var(--space-m);
  }

  .project-date {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--wc-bark);
    margin-bottom: var(--space-xs);
  }

  .project-date::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--wc-olive);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 600;
    color: var(--wc-ink);
    line-height: var(--leading-heading);
    margin: 0;
  }

  /* Content */
  .project-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .project-description {
    max-width: 65ch;
  }

  /* Grid layout */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  /* Images */
  .project-images {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .image-frame {
    position: relative;
    background: var(--wc-parchment);
    border: 3px solid var(--wc-sand);
    border-radius: var(--radius-md);
    padding: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--duration-normal) var(--ease-smooth);
  }

  .image-frame:hover {
    border-color: var(--wc-accent-muted);
  }

  .image-frame:hover .project-image {
    transform: scale(1.04);
  }

  .image-frame:hover .image-overlay {
    opacity: 1;
  }

  .project-image {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius-md) - 4px);
    display: block;
    transition: transform var(--duration-normal) var(--ease-smooth);
    will-change: transform;
  }

  .image-overlay {
    position: absolute;
    inset: 8px;
    background: linear-gradient(
      135deg,
      transparent 30%,
      color-mix(in oklab, var(--wc-accent) 15%, transparent) 100%
    );
    border-radius: calc(var(--radius-md) - 4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-smooth);
  }

  /* Tech stack */
  .project-tech {
    padding: var(--space-m);
    background: var(--wc-parchment);
    border: 1px dashed var(--wc-sand);
    border-radius: var(--radius-md);
  }

  .project-tech.full-width {
    grid-column: 1 / -1;
  }

  .tech-label {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--wc-bark);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-s);
  }

  /* Focus states */
  .image-frame:focus-visible {
    outline: 2px solid var(--wc-accent);
    outline-offset: 2px;
  }

  /* Mobile adjustments */
  @media (max-width: 767px) {
    .card-inner {
      padding: var(--space-m);
    }

    .card-inner:hover {
      transform: rotate(0deg) translateY(-2px);
    }

    .project-number {
      font-size: 2rem;
      top: var(--space-s);
      right: var(--space-s);
    }

    .card-tape-top {
      display: none;
    }
  }

  /* Scroll-reveal animations via CSS + IntersectionObserver. The card
     wrapper animates so inner rotation and hover transforms are never locked
     by a finished animation. */
  @media (prefers-reduced-motion: no-preference) {
    .project-card,
    .project-card .project-number,
    .project-card .project-header,
    .project-card .project-description,
    .project-card .image-frame {
      opacity: 0;
    }

    .project-card.in-view {
      animation: card-rise 0.7s var(--ease-out) forwards;
    }
    .project-card.in-view .project-number {
      animation: number-stamp 0.5s var(--ease-bounce) 0.3s forwards;
    }
    .project-card.in-view .project-header {
      animation: reveal-up 0.6s var(--ease-out) 0.4s forwards;
    }
    .project-card.in-view .project-description {
      animation: reveal-up 0.6s var(--ease-out) 0.5s forwards;
    }
    .project-card.in-view .image-frame {
      animation: reveal-up 0.6s var(--ease-out) 0.6s forwards;
    }
    .project-card.in-view .image-frame:nth-child(2) {
      animation-delay: 0.7s;
    }
    .project-card.in-view .image-frame:nth-child(3) {
      animation-delay: 0.8s;
    }

    @keyframes card-rise {
      from {
        opacity: 0;
        transform: translateY(40px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes number-stamp {
      from {
        opacity: 0;
        transform: scale(1.4) rotate(-10deg);
      }
      to {
        opacity: 0.3;
        transform: none;
      }
    }
    @keyframes reveal-up {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
