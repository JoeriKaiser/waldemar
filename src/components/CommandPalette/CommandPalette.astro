---

---

<div id="cmdk-overlay" hidden transition:persist="command-palette">
  <div id="cmdk-backdrop"></div>
  <div id="cmdk-panel" role="dialog" aria-modal="true">
    <div class="cmdk-header">
      <input
        id="cmdk-input"
        type="text"
        placeholder="Search projects, pages..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Search"
      />
    </div>
    <ul id="cmdk-list" role="listbox"></ul>
  </div>
</div>

<style>
  #cmdk-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
  }

  #cmdk-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(44, 36, 28, 0.4);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  #cmdk-panel {
    position: absolute;
    left: 50%;
    top: 15%;
    transform: translateX(-50%) scale(0.96);
    width: min(600px, calc(100% - 2rem));
    border-radius: var(--radius-lg);
    border: 1px solid var(--wc-sand);
    background: linear-gradient(180deg, var(--wc-cream) 0%, var(--wc-parchment) 100%);
    color: var(--wc-ink);
    box-shadow:
      var(--shadow-xl),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
    opacity: 0;
    transition:
      transform 200ms var(--ease-bounce),
      opacity 180ms ease;
  }

  .cmdk-header {
    padding: 1rem;
    border-bottom: 1px solid var(--wc-sand);
  }

  #cmdk-input {
    width: 100%;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--wc-sand);
    background: var(--wc-parchment);
    color: var(--wc-ink);
    font-family: var(--font-body);
    font-size: 1rem;
    outline: none;
    transition:
      border-color var(--duration-fast) var(--ease-smooth),
      box-shadow var(--duration-fast) var(--ease-smooth);
  }

  #cmdk-input:focus {
    border-color: var(--wc-accent);
    box-shadow: 0 0 0 3px var(--wc-accent-muted);
  }

  #cmdk-input::placeholder {
    color: var(--wc-bark);
    opacity: 0.6;
  }

  #cmdk-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    max-height: min(50vh, 400px);
    overflow: auto;
  }

  #cmdk-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-family: var(--font-body);
    color: var(--wc-espresso);
    transition:
      background var(--duration-fast) var(--ease-smooth),
      color var(--duration-fast) var(--ease-smooth);
  }

  #cmdk-list li:hover {
    background: var(--wc-sand);
  }

  #cmdk-list li[aria-selected="true"] {
    background: var(--wc-accent-muted);
    color: var(--wc-ink);
  }

  #cmdk-list .meta {
    font-size: 0.8rem;
    color: var(--wc-bark);
    opacity: 0.7;
  }

  #cmdk-list li[aria-selected="true"] .meta {
    color: var(--wc-accent-deep);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    #cmdk-backdrop,
    #cmdk-panel {
      transition: none;
    }
  }
</style>

<script>
  type Item = { label: string; url: string; meta: string };

  const staticItems: Item[] = [
    { label: "Home", url: "/", meta: "Page" },
    { label: "Projects", url: "/#projects-list-start", meta: "Page" },
    { label: "About", url: "/about", meta: "Page" },
    { label: "GitHub", url: "https://github.com/JoeriKaiser", meta: "External" },
    { label: "LinkedIn", url: "https://www.linkedin.com/in/joeri-kaiser", meta: "External" },
  ];

  document.addEventListener("astro:page-load", () => {
    const overlay = document.getElementById("cmdk-overlay");
    const backdrop = document.getElementById("cmdk-backdrop");
    const panel = document.getElementById("cmdk-panel");
    const input = document.getElementById("cmdk-input") as HTMLInputElement | null;
    const list = document.getElementById("cmdk-list");

    if (
      !(overlay instanceof HTMLElement) ||
      !(backdrop instanceof HTMLElement) ||
      !(panel instanceof HTMLElement) ||
      !input ||
      !(list instanceof HTMLUListElement)
    ) {
      return;
    }

    const overlayElement = overlay;
    const backdropElement = backdrop;
    const panelElement = panel;

    // The palette is persisted across Astro navigations; do not attach a
    // second set of window/document listeners when page-load fires again.
    if (overlayElement.dataset.initialized === "true") return;
    overlayElement.dataset.initialized = "true";

    let openState = false;
    let selected = 0;
    let items: Item[] = [];
    let previousActive: HTMLElement | null = null;
    let closeTimer: number | undefined;

    const getItems = () => {
      const projects = Array.from(
        document.querySelectorAll<HTMLElement>("[data-project-item]")
      ).map((project) => ({
        label: project.querySelector("[data-project-title]")?.textContent?.trim() || "Project",
        url: `/#${project.id}`,
        meta: "Project",
      }));
      return [...projects, ...staticItems];
    };

    const getRow = (target: EventTarget | null) => {
      if (!(target instanceof Element)) return null;
      const row = target.closest<HTMLLIElement>("#cmdk-list > li");
      return row && list.contains(row) ? row : null;
    };

    const updateSelection = () => {
      const rows = Array.from(list.children);
      if (!rows.length) {
        selected = 0;
        return;
      }
      selected = Math.max(0, Math.min(selected, rows.length - 1));
      rows.forEach((row, index) => {
        row.setAttribute("aria-selected", String(index === selected));
      });
      rows[selected]?.scrollIntoView({ block: "nearest" });
    };

    const render = (rows: Item[]) => {
      list.replaceChildren();
      rows.forEach((row, index) => {
        const item = document.createElement("li");
        item.setAttribute("role", "option");
        item.setAttribute("aria-selected", String(index === selected));
        item.dataset.index = String(index);
        item.dataset.url = row.url;

        const label = document.createElement("span");
        label.textContent = row.label;
        const meta = document.createElement("span");
        meta.className = "meta";
        meta.textContent = row.meta;
        item.append(label, meta);
        list.appendChild(item);
      });
    };

    const filter = (query: string) => {
      const normalized = query.trim().toLocaleLowerCase();
      return (
        normalized
          ? items.filter((item) => item.label.toLocaleLowerCase().includes(normalized))
          : items
      ).slice(0, 30);
    };

    function close() {
      if (!openState) return;
      openState = false;
      backdropElement.style.opacity = "0";
      panelElement.style.opacity = "0";
      panelElement.style.transform = "translateX(-50%) scale(0.96)";
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        overlayElement.hidden = true;
      }, 200);
      if (previousActive?.isConnected) previousActive.focus();
    }

    const navigate = (url: string) => {
      close();
      if (/^https?:\/\//.test(url)) {
        window.open(url, "_blank", "noopener,noreferrer");
      } else {
        window.location.href = url;
      }
    };

    const open = () => {
      if (openState) return;
      openState = true;
      previousActive = document.activeElement as HTMLElement | null;
      items = getItems();
      selected = 0;
      render(filter(input.value));
      overlayElement.hidden = false;
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);

      requestAnimationFrame(() => {
        backdropElement.style.opacity = "1";
        panelElement.style.opacity = "1";
        panelElement.style.transform = "translateX(-50%) scale(1)";
        input.focus({ preventScroll: true });
      });
    };

    const onGlobalKeydown = (event: KeyboardEvent) => {
      if (openState && event.key === "Escape") {
        event.preventDefault();
        close();
      }
    };

    window.addEventListener("open-command-palette", open);
    window.addEventListener("keydown", onGlobalKeydown);
    document.addEventListener("astro:before-preparation", close);
    backdropElement.addEventListener("click", close);

    list.addEventListener("mousemove", (event) => {
      const row = getRow(event.target);
      if (!row) return;
      const index = Number(row.dataset.index);
      if (Number.isInteger(index) && index !== selected) {
        selected = index;
        updateSelection();
      }
    });

    list.addEventListener("click", (event) => {
      const row = getRow(event.target);
      if (row) navigate(row.dataset.url || "/");
    });

    input.addEventListener("input", () => {
      selected = 0;
      render(filter(input.value));
    });

    input.addEventListener("keydown", (event) => {
      const rowCount = list.children.length;
      if (!rowCount) return;

      if (event.key === "ArrowDown") {
        event.preventDefault();
        selected = Math.min(rowCount - 1, selected + 1);
        updateSelection();
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        selected = Math.max(0, selected - 1);
        updateSelection();
      } else if (event.key === "Enter") {
        event.preventDefault();
        const row = list.children[selected] as HTMLElement | undefined;
        if (row) navigate(row.dataset.url || "/");
      }
    });
  });
</script>
